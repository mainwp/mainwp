{
    "name": "mainwp/dashboard",
    "description": "MainWP Dashboard Plugin",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "masterminds/html5": "^2.9",
        "phpcsstandards/phpcsutils": "^1.2.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MainWP\\Dashboard\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/abilities/",
            "tests/integration/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:dashboard",
            "@test:abilities",
            "@test:backup"
        ],
        "test:dashboard": "phpunit --testsuite=\"MainWP Dashboard Test Suite\"",
        "test:abilities": "phpunit --testsuite=Abilities",
        "test:backup": "phpunit --testsuite=Backup"
    },
    "scripts-descriptions": {
        "test": "Run the three phpunit testsuites as separate processes, the same shape CI uses. A single-process aggregate run (bare vendor/bin/phpunit) lets constants like DOING_CRON defined by one suite leak into another and silently bypass capability-denial tests. Requires WP_TESTS_DIR in the environment."
    }
}
